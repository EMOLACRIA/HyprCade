# ============================================================
# HYPRCADE // COWBOY BEBOP
# HYPRLOCK — SHIP SECURITY HUD
# ============================================================


general {
    hide_cursor = false
    ignore_empty_input = true
    immediate_render = true
}


# ============================================================
# BACKGROUND
# ============================================================

background {
    monitor =

    path = @WALLPAPER_PATH@

    blur_passes = 0

    brightness = 0.48
    contrast = 1.04

    vibrancy = 0.10
    vibrancy_darkness = 0.0
}


# ============================================================
# TOP SYSTEM MARKINGS
# ============================================================

label {
    monitor =

    text = HYPRCADE // @SYSTEM_NAME@

    color = rgb(@RED_HEX@)

    font_family = monospace
    font_size = 11

    position = 48, -40

    halign = left
    valign = top
}


label {
    monitor =

    text = SHIP SECURITY // LOCAL SESSION

    color = rgb(@MUTED_HEX@)

    font_family = monospace
    font_size = 8

    position = 48, -62

    halign = left
    valign = top
}


label {
