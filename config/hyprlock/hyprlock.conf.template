# ============================================================
# PASSWORD TERMINAL
# ============================================================

input-field {
    monitor =

    size = 560, 54

    position = 0, -125

    halign = center
    valign = center

    outline_thickness = 1
    rounding = 0

    outer_color = rgb(@BLUE_HEX@)
    inner_color = rgba(@BACKGROUND_RGB@, 0.92)

    font_color = rgb(@TEXT_HEX@)
    font_family = monospace

    dots_size = 0.17
    dots_spacing = 0.24
    dots_center = true
    dots_rounding = 0

    fade_on_empty = false

    placeholder_text = <span foreground="##@MUTED_HEX@">ACCESS CODE // ENTER PASSWORD</span>

    check_color = rgb(@TEAL_HEX@)
    check_text = LINK ESTABLISHED // VERIFYING

    fail_color = rgb(@RED_HEX@)
    fail_text = ACCESS DENIED // $FAIL

    capslock_color = rgb(@YELLOW_HEX@)
}


label {
    monitor =

    text = [ ENTER // RESTORE SESSION ]

    color = rgb(@RED_HEX@)

    font_family = monospace
    font_size = 9

    position = 0, -174

    halign = center
    valign = center
}


