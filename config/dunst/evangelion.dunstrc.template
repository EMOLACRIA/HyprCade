[global]

    # ─────────────────────────────────────
    # HYPRCADE // NERV NOTIFICATION SYSTEM
    # ─────────────────────────────────────

    monitor = 0
    follow = none

    width = (330, 410)
    height = (0, 160)

    origin = top-right
    offset = (16, 54)

    scale = 0
    notification_limit = 5

    # SHAPE
    corner_radius = 0
    frame_width = 1
    gap_size = 6
    separator_height = 0

    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10

    # TYPOGRAPHY
    font = Monospace 8
    line_height = 3

    markup = full

    alignment = left
    vertical_alignment = center

    word_wrap = yes
    ellipsize = end
    ignore_newline = no

    # PROGRESS
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 180
    progress_bar_max_width = 370
    progress_bar_corner_radius = 0

    # ICONS
    icon_position = off

    # BEHAVIOUR
    indicate_hidden = yes
    sort = yes

    show_age_threshold = 60
    sticky_history = yes
    history_length = 50

    stack_duplicates = true
    hide_duplicate_count = false

    browser = /usr/bin/xdg-open

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all


[urgency_low]

    background = "@BACKGROUND@"
    foreground = "@MUTED@"
    frame_color = "@BORDER@"
    highlight = "@MUTED@"

    format = "<span foreground='@MUTED@'><b>NERV // LOW PRIORITY</b></span>\n<b>%s</b>\n%b"

    timeout = 4


[urgency_normal]

    background = "@PANEL@"
    foreground = "@TEXT@"
    frame_color = "@BORDER@"
    highlight = "@RED@"

    format = "<span foreground='@MUTED@'><b>MAGI // %a</b></span>\n<b>%s</b>\n%b"

    timeout = 7


[urgency_critical]

    background = "@PANEL@"
    foreground = "@TEXT@"
    frame_color = "@RED@"
    highlight = "@RED@"

    format = "<span foreground='@RED@'><b>ALERT // PRIORITY ONE</b></span>\n<b>%s</b>\n%b"

    timeout = 0
